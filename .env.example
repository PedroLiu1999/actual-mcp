# ==============================================================================
# actual-mcp Environment Configuration
# Copy this file to .env and fill in your credentials before running Docker.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Public Endpoint Configuration
# ------------------------------------------------------------------------------

# Public HTTPS base URL exposed via Cloudflare Tunnel (no trailing slash).
# Your MCP endpoint will be reachable at ${PUBLIC_URL}/mcp.
PUBLIC_URL=https://actual-mcp.example.com

# HTTP port the container listens on (bound to 127.0.0.1:${PORT}:3000 on host).
PORT=3000

# Container image tag for actual-mcp (default: latest).
# Change to a specific version (e.g. 0.1.0) to pin the prebuilt image from ghcr.io.
ACTUAL_MCP_VERSION=latest

# Persistent data directory inside the container.
# Stores the Token Store (/data/oauth-tokens.json) and Budget Cache (/data/budget-cache).
DATA_DIR=/data

# ------------------------------------------------------------------------------
# 2. Embedded OAuth 2.1 Server (Google Gemini Connector)
# ------------------------------------------------------------------------------

# Pre-registered OAuth 2.1 Client ID entered in Google Gemini's
# "Connect to an MCP server" modal (Additional settings > Show more).
OAUTH_CLIENT_ID=actual-mcp-gemini

# Pre-registered OAuth 2.1 Client Secret (generate with: openssl rand -hex 32).
OAUTH_CLIENT_SECRET=replace-with-a-strong-random-client-secret

# Admin passphrase prompted on the HTML consent screen (GET /authorize) when
# linking your Google Gemini account for the first time.
OAUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-consent-passphrase

# Optional: Comma-separated list of additional allowed OAuth redirect URIs
# beyond Google Gemini's built-in redirect URI patterns.
OAUTH_EXTRA_REDIRECT_URIS=

# ------------------------------------------------------------------------------
# 3. Actual Budget Sync Server & Target Budget
# ------------------------------------------------------------------------------

# URL of your existing self-hosted Actual Budget Sync Server.
# When actual-server is bound to the VPS host or another container publishing a
# host port, use host.docker.internal (mapped via extra_hosts in docker-compose.yml).
ACTUAL_SERVER_URL=http://host.docker.internal:5006

# Password used to log in to your Actual Budget Sync Server.
ACTUAL_PASSWORD=replace-with-your-actual-server-password

# Sync ID (UUID) of the Target Budget to open.
# Find this in Actual Budget under: Settings -> Show advanced settings -> Sync ID.
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000

# Optional: End-to-end encryption password for the Target Budget (leave empty if unencrypted).
ACTUAL_ENCRYPTION_PASSWORD=

# Optional: Coalesced Sync TTL in seconds for read operations (default: 30).
# Reads reuse the local SQLite Budget Cache if synced within this window;
# writes always sync immediately before and after mutating.
SYNC_TTL_SECONDS=30
